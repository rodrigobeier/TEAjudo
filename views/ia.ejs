<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Chat IA - TEAjudo</title>
    <link rel="stylesheet" href="/css/style.css?v=3">
</head>
<body>

    <%- include("./partials/header") %>

    <div class="chat-container" 
         id="appChat" 
         data-conversa="<%= conversaId %>" 
         data-historico="<%= JSON.stringify(historico) %>">
         
        <aside class="sidebar">
            <button class="new-chat" id="btnNovaConversa">+ Nova conversa</button>
            <div class="history" id="listaConversas"></div>
        </aside>

        <main class="chat-main">
            <div class="chat-header">
                <h1 id="tituloChat">Como posso ajudar?</h1>
            </div>

            <div class="chat-box" id="chatBox"></div>

            <div class="chat-input">
                <input type="text" id="inputMensagem" placeholder="Digite sua pergunta sobre o TEA...">
                <button id="btnEnviar">Enviar</button>
            </div>
        </main>
    </div>

    <script>
        const appChat = document.getElementById('appChat');
        let conversaAtual = appChat.dataset.conversa;
        
        const historicoString = appChat.dataset.historico.replace(/&quot;/g, '"');
        const historico = JSON.parse(historicoString);

        const chatBox = document.getElementById('chatBox');
        const inputMsg = document.getElementById('inputMensagem');
        const btnEnviar = document.getElementById('btnEnviar');
        const btnNova = document.getElementById('btnNovaConversa');
        const listaConversas = document.getElementById('listaConversas');

        if (historico && historico.length > 0) {
            listaConversas.innerHTML = ''; 
            
            historico.forEach(conv => {
                const div = document.createElement('div');
                div.className = conv.id == conversaAtual ? 'history-item ativo' : 'history-item';
                div.textContent = conv.titulo;
                div.onclick = () => {
                    conversaAtual = conv.id;
                    document.querySelectorAll('.history-item').forEach(el => el.classList.remove('ativo'));
                    div.classList.add('ativo');
                    carregarHistorico(conv.id);
                };
                listaConversas.appendChild(div);
            });
        }

        function adicionarMensagem(texto, autor) {
            const div = document.createElement('div');
            div.className = 'mensagem ' + autor;
            div.textContent = texto;
            chatBox.classList.add('com-mensagens');
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function removerDigitando() {
            const d = chatBox.querySelector('.digitando');
            if (d) d.remove();
        }

        function mostrarDigitando() {
            removerDigitando();
            const div = document.createElement('div');
            div.className = 'mensagem ia digitando';
            div.textContent = 'Digitando...';
            chatBox.classList.add('com-mensagens');
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function limparChat() {
            chatBox.innerHTML = '';
            chatBox.classList.remove('com-mensagens');
        }

        async function enviarMensagem() {
            const texto = inputMsg.value.trim();
            if (!texto) return;

            // Atualiza o título visualmente se for a primeira mensagem
            if (chatBox.children.length === 0) {
                const itemAtivo = document.querySelector('.history-item.ativo');
                if (itemAtivo) {
                    itemAtivo.textContent = texto.length > 30 ? texto.substring(0, 30) + '...' : texto;
                }
            }

            adicionarMensagem(texto, 'usuario');
            inputMsg.value = '';
            inputMsg.disabled = true;
            btnEnviar.disabled = true;
            mostrarDigitando();

            try {
                const response = await fetch('/api/mensagens', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conversa_id: conversaAtual,
                        autor: 'usuario',
                        texto: texto
                    })
                });

                const data = await response.json();
                removerDigitando();

                if (data.mensagemIA) {
                    adicionarMensagem(data.mensagemIA.texto, 'ia');
                } else if (data.erroIA) {
                    adicionarMensagem('Nao consegui gerar resposta. Tente novamente.', 'sistema');
                } else {
                    adicionarMensagem('Resposta inesperada do servidor.', 'sistema');
                }
            } catch (error) {
                console.error('Erro no fetch:', error);
                removerDigitando();
                adicionarMensagem('Erro de conexao.', 'sistema');
            } finally {
                inputMsg.disabled = false;
                btnEnviar.disabled = false;
                inputMsg.focus();
            }
        }

        async function carregarHistorico(idConversa) {
            limparChat();
            try {
                const response = await fetch('/api/mensagens?conversa_id=' + idConversa);
                const mensagens = await response.json();
                
                if (mensagens.length === 0) {
                    adicionarMensagem('Esta conversa não tem mensagens.', 'sistema');
                } else {
                    mensagens.forEach(msg => {
                        adicionarMensagem(msg.texto, msg.autor);
                    });
                }
            } catch (error) {
                console.error('Erro ao carregar histórico:', error);
                adicionarMensagem('Erro ao carregar o histórico.', 'sistema');
            }
        }

        // ALTERADO AQUI: Redireciona forçando a criação de uma nova conversa
        function criarNovaConversa() {
            window.location.href = '/ia?nova=true';
        }

        btnEnviar.addEventListener('click', enviarMensagem);
        inputMsg.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') enviarMensagem();
        });
        btnNova.addEventListener('click', criarNovaConversa);

    </script>

</body>
</html>