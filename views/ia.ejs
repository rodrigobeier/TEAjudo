<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Chat IA - TEAjudo</title>
    <link rel="stylesheet" href="/css/style.css?v=3">
</head>
<body>

    <%- include("./partials/header") %>

    <div class="chat-container">
        <aside class="sidebar">
            <button class="new-chat" id="btnNovaConversa">+ Nova conversa</button>
            <div class="history" id="listaConversas"></div>
        </aside>

        <main class="chat-main">
            <div class="chat-header">
                <h1 id="tituloChat">Como posso ajudar?</h1>
            </div>

            <div class="chat-box" id="chatBox"></div>

            <div class="chat-input">
                <input type="text" id="inputMensagem" placeholder="Digite sua pergunta sobre o TEA...">
                <button id="btnEnviar">Enviar</button>
            </div>
        </main>
    </div>

    <script>
        let conversaAtual = 1;

        const chatBox = document.getElementById('chatBox');
        const inputMsg = document.getElementById('inputMensagem');
        const btnEnviar = document.getElementById('btnEnviar');
        const btnNova = document.getElementById('btnNovaConversa');

        function adicionarMensagem(texto, autor) {
            const div = document.createElement('div');
            div.className = 'mensagem ' + autor;
            div.textContent = texto;
            chatBox.classList.add('com-mensagens');
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function removerDigitando() {
            const d = chatBox.querySelector('.digitando');
            if (d) d.remove();
        }

        function mostrarDigitando() {
            removerDigitando();
            const div = document.createElement('div');
            div.className = 'mensagem ia digitando';
            div.textContent = 'Digitando...';
            chatBox.classList.add('com-mensagens');
            chatBox.appendChild(div);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function limparChat() {
            chatBox.innerHTML = '';
            chatBox.classList.remove('com-mensagens');
        }

        async function enviarMensagem() {
            console.log('enviarMensagem chamada');
            const texto = inputMsg.value.trim();
            if (!texto) return;

            adicionarMensagem(texto, 'usuario');
            inputMsg.value = '';
            inputMsg.disabled = true;
            btnEnviar.disabled = true;
            mostrarDigitando();

            try {
                const response = await fetch('/api/mensagens', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conversa_id: conversaAtual,
                        autor: 'usuario',
                        texto: texto
                    })
                });

                console.log('Status da resposta:', response.status);
                const data = await response.json();
                console.log('Dados recebidos:', data);

                removerDigitando();

                if (data.mensagemIA) {
                    adicionarMensagem(data.mensagemIA.texto, 'ia');
                } else if (data.erroIA) {
                    adicionarMensagem('Nao consegui gerar resposta. Tente novamente.', 'sistema');
                } else {
                    adicionarMensagem('Resposta inesperada do servidor.', 'sistema');
                }
            } catch (error) {
                console.error('Erro no fetch:', error);
                removerDigitando();
                adicionarMensagem('Erro de conexao.', 'sistema');
            } finally {
                inputMsg.disabled = false;
                btnEnviar.disabled = false;
                inputMsg.focus();
            }
        }

        function criarNovaConversa() {
            conversaAtual = Date.now();
            limparChat();
            adicionarMensagem('Nova conversa iniciada! Pergunte sobre o TEA.', 'ia');
        }

        btnEnviar.addEventListener('click', enviarMensagem);
        inputMsg.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') enviarMensagem();
        });
        btnNova.addEventListener('click', criarNovaConversa);

        console.log('Chat IA inicializado!');
    </script>

</body>
</html>