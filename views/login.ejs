<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="UTF-8">
    <title>Login</title>

    <link rel="stylesheet" href="/css/style.css">

</head>
<body>

    <div class="auth-container">

        <div class="auth-box">

            <h1>Entrar</h1>

            <input type="email" placeholder="E-mail">

            <input type="password" placeholder="Senha">

            <button>Entrar</button>

            <p>
                Não possui conta?
                <a href="/cadastro">Cadastrar</a>
            </p>

            <!-- Link "Voltar" agora no final, centralizado -->
            <a href="/" class="voltar-home">← Voltar para o início</a>

        </div>

    </div>

</body>
</html>