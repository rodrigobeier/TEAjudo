<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Meu Perfil - TEAjudo</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("./partials/header") %>

    <section class="sobre-page">
        
        <h1>Meu Perfil</h1>

        <div class="sobre-box">
            <h2>Dados da Conta</h2>
            
            <p><strong>Nome:</strong> <%= usuario.nome %></p>
            <p><strong>E-mail:</strong> <%= usuario.email %></p>

            <hr style="margin: 30px 0; border: 1px solid #f0f0f0;">

            <h2>Histórico de Conversas</h2>
            
            <% if (historico && historico.length > 0) { %>
                <ul style="list-style: none; padding: 0; margin-top: 15px;">
                    <% historico.forEach(function(conversa) { %>
                        <li style="padding: 12px 0; border-bottom: 1px solid #eee;">
                            <strong><%= conversa.titulo %></strong> 
                            <span style="font-size: 13px; color: #888; display: block; margin-top: 4px;">
                                Criada em: <%= new Date(conversa.data_criacao).toLocaleDateString('pt-BR') %>
                            </span>
                        </li>
                    <% }); %>
                </ul>
            <% } else { %>
                <p style="color: #666; font-style: italic;">
                    Você ainda não tem conversas salvas no chat.
                </p>
            <% } %>

            <hr style="margin: 30px 0; border: 1px solid #f0f0f0;">

            <!-- Botão para sair da conta -->
            <a href="/logout" class="voltar-home" style="background-color: #ffcccc; color: #cc0000;">
                Sair da conta
            </a>
        </div>

    </section>

</body>
</html>S